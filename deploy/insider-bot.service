# /etc/systemd/system/insider-bot.service
[Unit]
Description=お題当てゲーム GM ボット (Discord)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=insider
Group=insider
EnvironmentFile=/etc/insider.env
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/insider/current
ExecStart=/opt/insider/current/.venv/bin/python -m insider_bot
# __main__ は KeyboardInterrupt で終わるように書いてある。SIGINT なら asyncio.run が主タスクを取り消し、
# `async with bot` がゲートウェイを閉じてから終わる (SIGTERM だと閉じずに落ちる)
KillSignal=SIGINT
TimeoutStopSec=30
Restart=always
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes

[Install]
WantedBy=multi-user.target
