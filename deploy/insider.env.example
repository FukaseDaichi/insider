# /etc/insider.env (root:root, 0600) に置く。実際の値はパスワードマネージャに保管し、VM 再作成時はそこから復元する。
# GitHub Secrets には置かない。GEMINI_API_KEY は本番に置かない (音声は手元で作る)
DISCORD_TOKEN=
TYPESAFE_API_KEY=
LINE_CHANNEL_TOKEN=
LINE_CHANNEL_SECRET=
# Caddy が受けるホスト名。役職画像と特殊村フォームの URL、スタンプ応答のホームページに使う
PUBLIC_BASE_URL=https://insider.example.com
# LINE の返信 API をスタブ (deploy/verify/line_api_stub.py) へ向けて確かめるときだけ書く。終わったら必ず消す
# LINE_API_BASE_URL=http://127.0.0.1:18080
